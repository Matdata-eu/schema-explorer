<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="urn:test:shop:2"
  targetNamespace="urn:test:shop:2" elementFormDefault="qualified" version="2.0">
  <xs:include schemaLocation="common.xsd"/>

  <xs:element name="order" type="s:Order"/>
  <xs:element name="item" type="s:Item" abstract="true"/>
  <xs:element name="book" type="s:Item" substitutionGroup="s:item"/>
  <xs:element name="dvd" type="s:Item" substitutionGroup="s:item"/>
  <xs:element name="cd" type="s:Item"/>

  <xs:complexType name="Order">
    <xs:annotation><xs:documentation>An order placed by a customer.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="customer" type="s:Customer"/>
      <xs:element name="lines">
        <xs:complexType>
          <xs:sequence>
            <xs:element ref="s:item" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="count" type="xs:long"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
      <xs:element name="total" type="s:tAmount"/>
      <xs:element name="discount" type="s:tAmount" minOccurs="0"/>
      <xs:choice>
        <xs:element name="channel" type="xs:string"/>
        <xs:element name="store" type="xs:string"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="status" type="s:tStatus" default="new"/>
    <xs:attribute name="currency" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Customer">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="email" type="xs:string" minOccurs="0"/>
      <xs:element name="phone" type="xs:string" minOccurs="0" maxOccurs="2"/>
    </xs:sequence>
    <xs:attribute name="vip" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="Item" abstract="true">
    <xs:complexContent>
      <xs:extension base="s:Base">
        <xs:sequence>
          <xs:element name="title" type="xs:string"/>
          <xs:element name="price" type="s:tAmount"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Base">
    <xs:attribute name="sku" type="s:tCode"/>
  </xs:complexType>

  <xs:complexType name="PostalAddress">
    <xs:sequence>
      <xs:element name="street" type="xs:string"/>
      <xs:element name="city" type="xs:string"/>
      <xs:element name="zip" type="xs:string"/>
      <xs:element name="country" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="tStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="new"/>
      <xs:enumeration value="open"/>
      <xs:enumeration value="paid"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tCode">
    <xs:restriction base="xs:string">
      <xs:maxLength value="8"/>
      <xs:minLength value="2"/>
      <xs:pattern value="[A-Z]+"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
