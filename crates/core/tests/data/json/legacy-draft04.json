{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://example.com/legacy.json",
  "definitions": {
    "Price": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    },
    "Product": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "$ref": "#/definitions/Price" },
        "kind": { "enum": ["book", "music"] },
        "dimensions": {
          "type": "object",
          "properties": { "width": { "type": "number" } }
        }
      },
      "required": ["name", "price"]
    },
    "Book": {
      "allOf": [{ "$ref": "#/definitions/Product" }, { "properties": { "isbn": { "type": "string" } } }]
    }
  }
}
